<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RoomScheduler.Web</RootNamespace>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoomScheduler.Core\RoomScheduler.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Data lives at the repo root and is copied next to the built app. -->
    <None Include="..\..\Sept2026_Classroom-Types_Rooms_Report.csv"
          Link="Sept2026_Classroom-Types_Rooms_Report.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\data\course_history.csv" Link="data\course_history.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
