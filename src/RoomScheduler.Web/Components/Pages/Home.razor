@page "/"
@rendermode InteractiveServer
@inject SchedulingService Scheduling

<PageTitle>Schedule</PageTitle>

<h1>Generated schedule</h1>
<p class="explain">
    Synthetic sections assigned to real rooms. Raise the count to make them compete
    for space. Real course lists go through <NavLink href="upload">Upload</NavLink>.
</p>
<p class="meta">
    <b>@Scheduling.RoomCount</b> rooms, <b>@Scheduling.BuildingCount</b> buildings,
    <b>@Scheduling.History.RecordCount</b> past sections.
</p>

<div class="controls">
    <label for="count">Sections to generate</label>
    <input id="count" type="number" min="1" max="2000" @bind="_courseCount" />
    <button @onclick="RunScheduler" disabled="@_running">
        @(_running ? "Working" : "Generate and schedule")
    </button>
    @if (_result is not null)
    {
        <span class="summary">
            <strong>@_result.Assignments.Count</strong> assigned,
            <strong>@_result.UnresolvedConflicts.Count</strong> unplaced,
            <strong>@_historyDriven</strong> chosen from past usage
        </span>
    }
</div>

@if (_result is not null)
{
    <h2>Assigned</h2>
    @if (_result.Assignments.Count == 0)
    {
        <p class="empty">Nothing could be placed.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Course</th><th>Unique</th><th>Day</th><th>Hour</th>
                    <th>Room</th><th class="num">Cap</th><th class="num">Enrl</th>
                    <th>Instructor</th><th>Room chosen because</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (course, room) in _result.Assignments
                    .OrderBy(a => a.Course.MeetingDays.Count == 0 ? 99 : a.Course.MeetingDays.Min(d => (int)d))
                    .ThenBy(a => a.Course.StartTime))
                {
                    var why = _result.ExplainChoice(course, room);
                    var fromHistory = !why.StartsWith("best");
                    <tr>
                        <td class="mono">@course.CourseName</td>
                        <td class="mono dim">@course.UniqueNumber</td>
                        <td class="mono">@course.MeetingPattern</td>
                        <td class="mono">@course.ClockRange</td>
                        <td class="mono">@room.Building @room.RoomNumber</td>
                        <td class="num">@room.Capacity</td>
                        <td class="num">@course.EnrollmentCount</td>
                        <td>@course.ProfessorName</td>
                        <td class="@(fromHistory ? "why-history" : "why")">@why</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2>Unplaced</h2>
    @if (_result.UnresolvedConflicts.Count == 0)
    {
        <p class="empty">None.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Course</th><th>Unique</th><th>Day</th><th>Hour</th>
                    <th class="num">Enrl</th><th>Instructor</th><th>Reason</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in _result.UnresolvedConflicts)
                {
                    <tr>
                        <td class="mono">@course.CourseName</td>
                        <td class="mono dim">@course.UniqueNumber</td>
                        <td class="mono">@course.MeetingPattern</td>
                        <td class="mono">@course.ClockRange</td>
                        <td class="num">@course.EnrollmentCount</td>
                        <td>@course.ProfessorName</td>
                        <td class="warn">@ReasonFor(course)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private int _courseCount = 25;
    private bool _running;
    private Scheduler? _result;
    private int _historyDriven;

    protected override void OnInitialized() => RunScheduler();

    private void RunScheduler()
    {
        _running = true;
        _courseCount = Math.Clamp(_courseCount, 1, 2000);

        _result = Scheduling.RunGenerated(_courseCount);
        _historyDriven = _result.Assignments
            .Count(a => !_result.ExplainChoice(a.Course, a.Room).StartsWith("best"));

        _running = false;
    }

    /// <summary>Distinguishes "no room is big enough" from "they were all busy".</summary>
    private string ReasonFor(Course course)
    {
        bool anyBigEnough = Scheduling.Rooms.Any(r => r.Capacity >= course.EnrollmentCount);
        return anyBigEnough
            ? "all rooms that fit were booked at this time"
            : "no room is large enough";
    }
}
