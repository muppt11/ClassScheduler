@page "/rooms"
@inject PlanningService Planning

<PageTitle>Rooms</PageTitle>

<h1>Rooms</h1>
<p class="meta">
    <b>@Planning.Rooms.Count</b> rooms from @Planning.RoomsSource,
    <b>@Planning.Rooms.Count(r => r.LectureCapture)</b> with Lectures Online,
    <b>@Planning.Rooms.Count(Offline)</b> offline.
</p>

<details open>
    <summary>Add a room</summary>
    <p class="hint">Added rooms stay saved in this browser, including when you upload a new rooms table. Rebuild the schedule to use them.</p>
    <form @onsubmit="AddRoom" @onsubmit:preventDefault>
        <div class="form">
            <label for="new-room-building">Building code</label>
            <input id="new-room-building" list="room-building-codes" placeholder="e.g. GDC" required maxlength="5" @bind="_newBuilding" />
            <datalist id="room-building-codes">
                @foreach (var building in Planning.Rooms.Select(r => r.Building).Concat(Planning.Campus.Buildings).Distinct().OrderBy(b => b))
                { <option value="@building"></option> }
            </datalist>
            <label for="new-room-number">Room number</label>
            <input id="new-room-number" placeholder="e.g. 2.216 or 116" required @bind="_newNumber" />
            <label for="new-room-capacity">Capacity (seats)</label>
            <input id="new-room-capacity" type="number" min="1" max="2147483647" step="1" required @bind="_newCapacity" />
            <label for="new-room-features">Features</label>
            <input id="new-room-features" placeholder="e.g. CON Wb CWS" @bind="_newFeatures" />
            <label>Options</label>
            <div>
                <label class="inline"><input type="checkbox" @bind="_newCapture" /> Lectures Online / lecture capture</label>
                <label class="inline"><input type="checkbox" @bind="_newDepartmentOnly" /> CS-only departmental room</label>
            </div>
            <label for="new-room-notes">Notes</label>
            <textarea id="new-room-notes" rows="2" @bind="_newNotes"></textarea>
        </div>
        <div class="controls"><button type="submit">Add room</button></div>
    </form>
    @if (_addError != null) { <p class="problems" role="alert">@_addError</p> }
    @if (_addedMessage != null) { <p class="summary" role="status">@_addedMessage</p> }
</details>

<h2>Offline</h2>
<p class="explain">
    Check a building to take every room in it offline, or open it to pick single rooms.
    The scheduler never puts a class in an offline room.
</p>

@if (_changed || Planning.RequiresRebuild)
{
    <div class="problems">Room or planning settings changed. Rebuild the schedule on the Semester plan page to apply.</div>
}

<div class="offline">
    @foreach (var b in Buildings())
    {
        var rooms = RoomsIn(b);
        int off = rooms.Count(Offline);
        bool whole = Planning.Rules.Offline.BuildingOffline(b);
        <div class="bldg @(off > 0 ? "has-off" : "")">
            <div class="bldg-head">
                <label class="inline">
                    <input type="checkbox" checked="@whole" @onchange="e => SetBuilding(b, (bool)e.Value!)" />
                    <b class="mono">@b</b>
                    <span class="dim">@Planning.Campus.Names.GetValueOrDefault(b, "")</span>
                </label>
                <span class="summary">
                    @(off == 0 ? $"{rooms.Count} rooms" : off == rooms.Count ? $"all {rooms.Count} offline" : $"{off} of {rooms.Count} offline")
                </span>
                <button class="ghost small" @onclick="() => Toggle(b)">@(_open.Contains(b) ? "hide rooms" : "rooms")</button>
            </div>
            @if (_open.Contains(b))
            {
                <div class="bldg-rooms">
                    @foreach (var r in rooms)
                    {
                        <label class="inline">
                            <input type="checkbox" checked="@Offline(r)" @onchange="e => SetRoom(r, (bool)e.Value!)" />
                            <span class="mono">@r.RoomNumber</span> <span class="dim">(@r.Capacity)</span>
                        </label>
                    }
                </div>
            }
        </div>
    }
</div>

<h2>All rooms</h2>
<div class="controls">
    <label for="filter">Filter</label>
    <input id="filter" placeholder="building, room or feature" @bind="_filter" @bind:event="oninput" />
    <label class="inline"><input type="checkbox" @bind="_onlyUsed" /> only rooms in the current schedule</label>
    <span class="summary"><strong>@Filtered().Count()</strong> rooms</span>
</div>

<div class="tablewrap">
<table class="plan-table">
    <thead>
        <tr>
            <th>Room</th><th class="num">Capacity</th><th>Features</th><th>Lectures Online</th>
            <th>Status</th><th class="num" title="Classes in the current schedule">Classes</th>
            <th class="num" title="Sections in this room from active uploaded schedules, including hybrid classes">CS history</th><th>Notes</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Filtered())
        {
            int classes = Planning.LatestPlan?.InRoom(r).Count ?? 0;
            <tr class="@(Offline(r) ? "row-off" : "")">
                <td class="mono nowrap">@(classes > 0 ? PlanExport.UsedMark : "")@r.DisplayName</td>
                <td class="num">@r.Capacity</td>
                <td class="mono">@string.Join(" ", r.Features.OrderBy(f => f))</td>
                <td>@(r.LectureCapture ? "yes" : "")</td>
                <td>@(Offline(r) ? "offline" : r.NonStandard ? "avoid (NSC)" : r.DepartmentOnly ? "CS only" : "")</td>
                <td class="num">@(classes > 0 ? classes : "")</td>
                <td class="num" title="@string.Join("; ", Planning.Past.InRoom(r.DisplayName).Select(s => $"{s.Semester}: {s.Course} {s.Title}{(s.Hybrid ? " (hybrid)" : "")}"))">@(Planning.Past.InRoom(r.DisplayName).Count is int n && n > 0 ? n : "")</td>
                <td class="dim">@r.Notes</td>
            </tr>
        }
    </tbody>
</table>
</div>

<p class="hint">
    Features: CWS continuous writing surface, Wb whiteboard, Gb glass board, Bb blackboard, MC movable chairs,
    TBL movable tables, SEM seminar room, DP dual projector, LM limited media, CON media console,
    NSC non-standard classroom (avoided).
</p>

@code {
    private string _newBuilding = "";
    private string _newNumber = "";
    private int? _newCapacity;
    private string _newFeatures = "";
    private string _newNotes = "";
    private bool _newCapture;
    private bool _newDepartmentOnly;
    private string? _addError;
    private string? _addedMessage;

    private void AddRoom()
    {
        _addError = null; _addedMessage = null;
        try
        {
            var room = Planning.AddRoom(_newBuilding, _newNumber, _newCapacity ?? 0, _newFeatures,
                _newCapture, _newDepartmentOnly, _newNotes);
            _filter = room.DisplayName; _onlyUsed = false; _open.Add(room.Building);
            _addedMessage = $"Saved {room.DisplayName} ({room.Capacity} seats). " +
                (Offline(room) ? "This room is offline; enable it in the Offline list before scheduling. " : "") +
                (Planning.LatestPlan != null ? "Rebuild on Semester plan to use it." : "It is available for your next schedule.");
            _newBuilding = room.Building; _newNumber = ""; _newCapacity = null;
            _newFeatures = _newNotes = ""; _newCapture = _newDepartmentOnly = false;
        }
        catch (Exception ex) { _addError = ex.Message; }
    }

    private string _filter = "";
    private bool _onlyUsed;
    private bool _changed;
    private readonly HashSet<string> _open = new();

    private bool Offline(Room r) => Planning.Rules.Offline.IsOffline(r);

    private IEnumerable<string> Buildings() =>
        Planning.Rooms.Select(r => r.Building).Distinct().OrderBy(b => b);

    private List<Room> RoomsIn(string b) =>
        Planning.Rooms.Where(r => r.Building == b).OrderBy(r => r.RoomNumber).ToList();

    private void Toggle(string b)
    {
        if (!_open.Remove(b)) _open.Add(b);
    }

    private void SetBuilding(string b, bool offline)
    {
        Planning.Rules.Offline.SetBuilding(b, offline, Planning.Rooms);
        _changed = true;
    }

    private void SetRoom(Room r, bool offline)
    {
        Planning.Rules.Offline.SetRoom(r, offline, Planning.Rooms);
        _changed = true;
    }

    private IEnumerable<Room> Filtered() =>
        Planning.Rooms
            .Where(r => !_onlyUsed || (Planning.LatestPlan?.InRoom(r).Count ?? 0) > 0)
            .Where(r => _filter.Length == 0 ||
                        $"{r.DisplayName} {string.Join(" ", r.Features)} {r.Notes}".Contains(_filter, StringComparison.OrdinalIgnoreCase))
            .OrderBy(r => r.Building).ThenBy(r => r.RoomNumber);
}
