@page "/faculty"
@inject PlanningService Planning
@inject NavigationManager Nav

<PageTitle>Faculty</PageTitle>

<h1>Faculty</h1>

<p class="hint">Manage tracks and scheduling priority in one roster. Select a professor for availability, accommodations, and notes.</p>

<div class="faculty-toolbar">
    <div class="faculty-views" role="group" aria-label="Professor list">
        <button class="@(!_showPast ? "on" : "ghost")" aria-pressed="@(!_showPast ? "true" : "false")" @onclick="() => ShowPast(false)">Current professors (@Planning.Faculty.All.Count())</button>
        <button class="@(_showPast ? "on" : "ghost")" aria-pressed="@(_showPast ? "true" : "false")" @onclick="() => ShowPast(true)">Past professors (@Planning.Faculty.RemovedProfiles.Count())</button>
    </div>
    <input type="search" aria-label="Search professors" placeholder="Search professors" @bind="_search" @bind:event="oninput" />
</div>

@if (_removalMessage != null)
{
    <p class="faculty-status" role="status">@_removalMessage</p>
}
@if (_restoreError != null) { <p role="alert">@_restoreError</p> }
@if (_directoryError != null) { <p role="alert">@_directoryError</p> }
@if (Planning.RequiresRebuild)
{
    <div class="problems rebuild">
        Faculty changes are saved. Rebuild the schedule to apply them.
        <button @onclick="RebuildAndShow" disabled="@_busy">@(_busy ? "Working" : "Rebuild schedule")</button>
    </div>
}

@if (_showPast)
{
    <section class="past-professors" aria-labelledby="past-professors-title">
        <h2 id="past-professors-title">Past professors</h2>
        <p>Professors removed from scheduling stay here so you can add them back at any time.</p>
        <p class="hint">Adding someone back makes their classes eligible for the next build. Previously deleted notes, accommodations, and complaints are not recovered.</p>
        @if (!Planning.Faculty.RemovedProfiles.Any())
        {
            <p class="empty">No past professors. Professors you remove will appear here with an Add back option.</p>
        }
        else if (!PastProfessors.Any())
        {
            <p class="empty">No past professors match “@_search”.</p>
        }
        else
        {
            <table class="plan-table">
                <thead><tr><th scope="col">Professor</th><th scope="col">Action</th></tr></thead>
                <tbody>
                    @foreach (var professor in PastProfessors)
                    {
                        <tr @key="professor.Surname">
                            <td>@ProfessorName(professor)</td>
                            <td><button class="ghost" disabled="@_busy" aria-label="@($"Add back {ProfessorName(professor)}")" @onclick="() => AddProfessorBack(professor.Surname)">Add back</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}
else
{
<div class="faculty">
    <section class="faculty-directory" aria-label="Current professors">
        <p class="hint">Track: T = tenure, P = professional. Difficult (D) gives scheduling priority.</p>
        @if (!Planning.Faculty.All.Any())
        {
            <p class="empty">No current profiles. Build a schedule on Semester plan, or add someone back from Past professors.</p>
        }
        else if (!CurrentProfessors.Any())
        {
            <p class="empty">No current professors match “@_search”.</p>
        }
        else
        {
            <div class="faculty-roster-scroll">
                <table class="faculty-roster">
                    <thead><tr><th scope="col">Professor / profile</th><th scope="col">Track</th><th scope="col">D</th></tr></thead>
                    <tbody>
                        @foreach (var professor in CurrentProfessors)
                        {
                            <tr @key="professor.Surname" class="@(_selected == professor ? "selected" : "")">
                                <td>
                                    <button class="person" aria-pressed="@(_selected == professor ? "true" : "false")" @onclick="() => Select(professor)">
                                        <span>@ProfessorName(professor)</span>
                                        <span class="tags">
                                            @if (professor.HasAccommodations) { <span class="tag" title="Has accommodations">acc</span> }
                                            @if (professor.Complaints.Count > 0) { <span class="tag" title="Complaints">@professor.Complaints.Count</span> }
                                        </span>
                                    </button>
                                </td>
                                <td>
                                    <select value="@professor.Track" disabled="@_busy" aria-label="@($"Track for {ProfessorName(professor)}")" @onchange="e => SetTrack(professor, Enum.Parse<FacultyTrack>(e.Value!.ToString()!))">
                                        <option value="@FacultyTrack.Unknown">None</option>
                                        <option value="@FacultyTrack.Tenure">T</option>
                                        <option value="@FacultyTrack.Professional">P</option>
                                    </select>
                                </td>
                                <td><input type="checkbox" checked="@professor.Difficult" disabled="@_busy" aria-label="@($"Difficult priority for {ProfessorName(professor)}")" @onchange="e => SetDifficult(professor, (bool)e.Value!)" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <FacultyTrackSave Disabled="_busy" OnSaved="() => { _directoryError = null; }" />
        }
    </section>

    @if (_selected != null)
    {
        var p = _selected;
        <div class="profile">
            <h2>@p.DisplayName</h2>

            <div class="form">
                <label for="unav">Unavailable</label>
                <div>
                    <input id="unav" class="wide" placeholder="e.g. TTH 8:00-9:30; F 1:00-5:00" @bind="p.Unavailable" @bind:event="oninput" />
                    <div class="hint">
                        @if (p.Unavailable.Trim().Length > 0)
                        {
                            var times = p.UnavailableTimes();
                            @(times.Count == 0 ? "Could not read that. Use days then a time range." : "Reads as: " + string.Join(", ", times))
                        }
                        else
                        {
                            @("Family, another job, or anything else outside the department. Separate entries with ;")
                        }
                    </div>
                </div>

                <label for="ext">Outside situation</label>
                <textarea id="ext" rows="2" @bind="p.ExternalNotes" placeholder="Why, for whoever reads this next. Not used by the scheduler."></textarea>

                <label>Accommodations</label>
                <div>
                    <label class="inline"><input type="checkbox" @bind="p.GroundFloorOnly" /> Ground floor or basement only</label>
                    <label class="inline">
                        Longest walk between back-to-back classes
                        <input type="number" min="0" max="30" @bind="p.MaxWalkMinutes" /> min
                    </label>
                    <label class="inline">
                        Room must have
                        <input placeholder="e.g. CWS Wb" @bind="p.RequiredFeatures" />
                    </label>
                    <textarea rows="2" @bind="p.AccommodationNotes" placeholder="Notes (shown on the review queue)"></textarea>
                    <div class="hint">Feature codes: CWS continuous writing surface, Wb whiteboard, Gb glass board, Bb blackboard, MC movable chairs, TBL movable tables, SEM seminar room, DP dual projector, LM limited media, CON media console (nearly every room). NSC rooms (non-standard) are avoided.</div>
                </div>

                <label>Complaints</label>
                <div>
                    @foreach (var c in p.Complaints.OrderByDescending(c => c.Date))
                    {
                        <div class="complaint">
                            <span class="dim mono">@c.Date.ToString("yyyy-MM-dd")</span> @c.Text
                            <button class="ghost small" @onclick="() => p.Complaints.Remove(c)">remove</button>
                        </div>
                    }
                    <div class="add">
                        <input class="wide" placeholder="Add a complaint or room issue" @bind="_newComplaint" />
                        <button class="ghost" @onclick="AddComplaint" disabled="@(_newComplaint.Trim().Length == 0)">Add</button>
                    </div>
                </div>
            </div>

            <div class="controls">
                <button @onclick="Save">Save profile</button>
                @if (_saved && Planning.LatestPlan != null)
                {
                    <span class="summary">Saved.</span>
                    <button class="ghost" @onclick="RebuildAndShow" disabled="@_busy">@(_busy ? "Working" : "Rebuild schedule")</button>
                }
                else if (_saved)
                {
                    <span class="summary">Saved. Build a schedule on the Semester plan page to use it.</span>
                }
            </div>

            <details class="permanent-removal" @key="p.Surname">
                <summary>Remove professor permanently</summary>
                <p>This deletes @p.DisplayName’s saved profile, track, priority, notes, accommodations, and complaints from this browser. Future uploads will not restore the profile.</p>
                <p>Their classes and discussions will also be excluded from future schedules.</p>
                <p class="hint">The current plan stays visible until you rebuild. Uploaded source files are kept. You can add them back from Past professors, but deleted profile details will not be recovered.</p>
                <label class="inline"><input type="checkbox" @bind="_confirmRemoval" /> I want to permanently remove @p.DisplayName</label>
                <button class="ghost" @onclick="RemoveProfessor" disabled="@(_busy || !_confirmRemoval)">Permanently remove professor</button>
                @if (_removalError != null) { <p role="alert">@_removalError</p> }
            </details>

            @{
                var sections = Planning.LatestPlan?.Placements.Where(x => x.Section.Surname == p.Surname).ToList();
            }
            @if (sections?.Count > 0)
            {
                <h2>In the current plan</h2>
                <table>
                    <tbody>
                        @foreach (var x in sections)
                        {
                            <tr>
                                <td class="mono">@x.Section.Title</td>
                                <td class="mono">@x.Time</td>
                                <td class="mono">@x.Room?.DisplayName</td>
                                <td>@string.Join("; ", x.Section.Flags.Where(f => f.Level != FlagLevel.Info).Select(f => f.Message))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
    else
    {
        <div class="faculty-profile-empty">
            <h2>Professor details</h2>
            <p>Select a name in the roster to edit availability, accommodations, notes, or complaints.</p>
            <p class="hint">Track and priority are edited directly in the roster. To restore someone who was removed, open Past professors.</p>
        </div>
    }
</div>
}

@code {
    private string _search = "";
    private FacultyProfile? _selected;
    private string _newComplaint = "";
    private bool _saved;
    private bool _showPast;
    private string? _directoryError;
    private IEnumerable<FacultyProfile> CurrentProfessors => Planning.Faculty.All.Where(MatchesSearch);
    private IEnumerable<FacultyProfile> PastProfessors => Planning.Faculty.RemovedProfiles.Where(MatchesSearch);
    private static string ProfessorName(FacultyProfile profile) => string.IsNullOrWhiteSpace(profile.DisplayName) ? profile.Surname : profile.DisplayName;
    private bool MatchesSearch(FacultyProfile profile) => ProfessorName(profile).Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) || profile.Surname.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase);

    private void ShowPast(bool past)
    {
        _showPast = past;
        _search = "";
        _restoreError = null;
    }
    private bool _confirmRemoval;
    private string? _removalMessage, _removalError, _restoreError;

    private void AddProfessorBack(string surname)
    {
        _restoreError = null;
        try
        {
            var profile = Planning.Faculty.AddBack(surname);
            Select(profile);
            _search = "";
            _showPast = false;
            _removalMessage = $"{profile.DisplayName} was added back. Rebuild the schedule to include their classes and discussions from the current files. Deleted profile details have not been recovered.";
        }
        catch (InvalidOperationException ex) { _restoreError = ex.Message; }
        catch (ArgumentException ex) { _restoreError = ex.Message; }
    }

    private void RemoveProfessor()
    {
        if (_selected == null || !_confirmRemoval) return;
        string name = _selected.DisplayName;
        try
        {
            Planning.Faculty.RemovePermanently(_selected.Surname);
            _selected = null; _saved = false; _confirmRemoval = false; _newComplaint = "";
            _showPast = true; _search = "";
            _removalMessage = $"{name} was removed. You can add them back below from Past professors. Rebuild to exclude their classes and discussions.";
        }
        catch (InvalidOperationException ex) { _removalError = ex.Message; }
        catch (ArgumentException ex) { _removalError = ex.Message; }
    }

    private void Select(FacultyProfile p)
    {
        _selected = p;
        _confirmRemoval = false; _removalError = null;
        _saved = false;
        _newComplaint = "";
    }

    private void AddComplaint()
    {
        _selected!.Complaints.Add(new Complaint { Date = DateTime.Today, Text = _newComplaint.Trim() });
        _newComplaint = "";
        Save();
    }

    private bool _busy;

    private void SetTrack(FacultyProfile profile, FacultyTrack track)
    {
        profile.SetTrack(track);
        SaveDirectory();
    }

    private void SetDifficult(FacultyProfile profile, bool difficult)
    {
        profile.SetDifficult(difficult);
        SaveDirectory();
    }

    private void SaveDirectory()
    {
        _directoryError = null;
        try { Planning.Faculty.Save(); }
        catch (InvalidOperationException ex) { _directoryError = $"Could not save faculty changes: {ex.Message} Use Save faculty tracks to retry."; }
    }

    /// <summary>Reruns the last schedule with the saved profiles, then shows it.</summary>
    private async Task RebuildAndShow()
    {
        _busy = true;
        StateHasChanged();
        await Task.Delay(50);
        Planning.Build(Planning.LatestSource);
        _busy = false;
        Nav.NavigateTo("");
    }

    private void Save()
    {
        Planning.Faculty.Save();
        _saved = true;
    }
}
