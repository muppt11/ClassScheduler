@page "/faculty"
@inject PlanningService Planning
@inject NavigationManager Nav

<PageTitle>Faculty</PageTitle>

<h1>Faculty</h1>

@if (Planning.Faculty.All.Any())
{
    <details class="tracklist" open="@_trackListOpen">
        <summary @onclick="() => _trackListOpen = !_trackListOpen">Track list: tenure (T) or professional (P), and difficult (D)</summary>
        <p class="hint">Check T or P to assign a track; uncheck it to remove the assignment. Uncheck D to remove difficult priority. Click Save faculty tracks to confirm your selections. Rebuild the schedule to apply changes.</p>
        <FacultyTrackSave Disabled="_busy" OnSaved="() => _trackChanged = Planning.RequiresRebuild" />
        @if (_trackChanged)
        {
            <div class="problems rebuild">
                Changed. Rebuild the schedule to apply.
                @if (Planning.LatestPlan != null)
                {
                    <button @onclick="RebuildAndShow" disabled="@_busy">@(_busy ? "Working" : "Rebuild now")</button>
                }
            </div>
        }
        <table class="plan-table tracktable">
            <thead><tr><th>Instructor</th><th>T</th><th>P</th><th>D</th></tr></thead>
            <tbody>
                @foreach (var f in Planning.Faculty.All)
                {
                    <tr>
                        <td>@f.DisplayName</td>
                        <td><input type="checkbox" checked="@(f.Track == FacultyTrack.Tenure)"
                                   @onchange="e => SetTrack(f, (bool)e.Value! ? FacultyTrack.Tenure : FacultyTrack.Unknown)" title="Tenure track: uncheck to remove" aria-label="@($"Tenure track for {f.DisplayName}")" /></td>
                        <td><input type="checkbox" checked="@(f.Track == FacultyTrack.Professional)"
                                   @onchange="e => SetTrack(f, (bool)e.Value! ? FacultyTrack.Professional : FacultyTrack.Unknown)" title="Professional track: uncheck to remove" aria-label="@($"Professional track for {f.DisplayName}")" /></td>
                        <td><input type="checkbox" checked="@f.Difficult"
                                   @onchange="e => SetDifficult(f, (bool)e.Value!)" title="Difficult: scheduled first" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </details>
}

@if (_removalMessage != null)
{
    <p role="status">@_removalMessage</p>
    @if (Planning.RequiresRebuild)
    {
        <button class="ghost" @onclick="RebuildAndShow" disabled="@_busy">Rebuild schedule</button>
    }
}

@if (Planning.Faculty.RemovedProfiles.Any())
{
    <details class="tracklist">
        <summary>Removed professors (@Planning.Faculty.RemovedProfiles.Count())</summary>
        <p class="hint">Add a professor back to include their classes and discussions in the next build. Deleted notes, accommodations, and complaints are not recovered. Track and priority can be imported again from your files.</p>
        <table class="plan-table">
            <thead><tr><th>Professor</th><th>Action</th></tr></thead>
            <tbody>
                @foreach (var professor in Planning.Faculty.RemovedProfiles)
                {
                    <tr @key="professor.Surname">
                        <td>@(string.IsNullOrWhiteSpace(professor.DisplayName) ? professor.Surname : professor.DisplayName)</td>
                        <td><button class="ghost small" disabled="@_busy" aria-label="@($"Add back {professor.Surname}")" @onclick="() => AddProfessorBack(professor.Surname)">Add back</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </details>
}
@if (_restoreError != null) { <p role="alert">@_restoreError</p> }

<div class="faculty">
    <div class="list">
        <input placeholder="search" @bind="_search" @bind:event="oninput" />
        @foreach (var p in Planning.Faculty.All.Where(p => _search.Length == 0 ||
                     p.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        {
            <button class="@(_selected == p ? "person on" : "person")" @onclick="() => Select(p)">
                @p.DisplayName
                <span class="tags">
                    @if (p.Difficult) { <span class="tag d">D</span> }
                    @(p.Track == FacultyTrack.Tenure ? "T" : p.Track == FacultyTrack.Professional ? "P" : "")
                    @if (p.HasAccommodations) { <span class="tag">acc</span> }
                    @if (p.Complaints.Count > 0) { <span class="tag">@p.Complaints.Count</span> }
                </span>
            </button>
        }
        @if (!Planning.Faculty.All.Any())
        {
            <p class="empty">No profiles yet. Build a schedule on the Semester plan page first.</p>
        }
    </div>

    @if (_selected != null)
    {
        var p = _selected;
        <div class="profile">
            <h2>@p.DisplayName</h2>

            <div class="form">
                <label>Priority</label>
                <div>
                    <label class="inline"><input type="checkbox" @bind="p.Difficult" @bind:after="() => p.SetDifficult(p.Difficult)" /> Difficult (D): schedule first</label>
                </div>

                <label for="track">Track</label>
                <select id="track" @bind="p.Track" @bind:after="() => p.SetTrack(p.Track)">
                    <option value="@FacultyTrack.Unknown">None / unassigned</option>
                    <option value="@FacultyTrack.Tenure">Tenure / tenure track (T)</option>
                    <option value="@FacultyTrack.Professional">Professional track (P)</option>
                </select>

                <label for="unav">Unavailable</label>
                <div>
                    <input id="unav" class="wide" placeholder="e.g. TTH 8:00-9:30; F 1:00-5:00" @bind="p.Unavailable" @bind:event="oninput" />
                    <div class="hint">
                        @if (p.Unavailable.Trim().Length > 0)
                        {
                            var times = p.UnavailableTimes();
                            @(times.Count == 0 ? "Could not read that. Use days then a time range." : "Reads as: " + string.Join(", ", times))
                        }
                        else
                        {
                            @("Family, another job, or anything else outside the department. Separate entries with ;")
                        }
                    </div>
                </div>

                <label for="ext">Outside situation</label>
                <textarea id="ext" rows="2" @bind="p.ExternalNotes" placeholder="Why, for whoever reads this next. Not used by the scheduler."></textarea>

                <label>Accommodations</label>
                <div>
                    <label class="inline"><input type="checkbox" @bind="p.GroundFloorOnly" /> Ground floor or basement only</label>
                    <label class="inline">
                        Longest walk between back-to-back classes
                        <input type="number" min="0" max="30" @bind="p.MaxWalkMinutes" /> min
                    </label>
                    <label class="inline">
                        Room must have
                        <input placeholder="e.g. CWS Wb" @bind="p.RequiredFeatures" />
                    </label>
                    <textarea rows="2" @bind="p.AccommodationNotes" placeholder="Notes (shown on the review queue)"></textarea>
                    <div class="hint">Feature codes: CWS continuous writing surface, Wb whiteboard, Gb glass board, Bb blackboard, MC movable chairs, TBL movable tables, SEM seminar room, DP dual projector, LM limited media, CON media console (nearly every room). NSC rooms (non-standard) are avoided.</div>
                </div>

                <label>Complaints</label>
                <div>
                    @foreach (var c in p.Complaints.OrderByDescending(c => c.Date))
                    {
                        <div class="complaint">
                            <span class="dim mono">@c.Date.ToString("yyyy-MM-dd")</span> @c.Text
                            <button class="ghost small" @onclick="() => p.Complaints.Remove(c)">remove</button>
                        </div>
                    }
                    <div class="add">
                        <input class="wide" placeholder="Add a complaint or room issue" @bind="_newComplaint" />
                        <button class="ghost" @onclick="AddComplaint" disabled="@(_newComplaint.Trim().Length == 0)">Add</button>
                    </div>
                </div>
            </div>

            <div class="controls">
                <button @onclick="Save">Save profile</button>
                @if (_saved && Planning.LatestPlan != null)
                {
                    <span class="summary">Saved.</span>
                    <button class="ghost" @onclick="RebuildAndShow" disabled="@_busy">@(_busy ? "Working" : "Rebuild schedule")</button>
                }
                else if (_saved)
                {
                    <span class="summary">Saved. Build a schedule on the Semester plan page to use it.</span>
                }
            </div>

            <details class="permanent-removal" @key="p.Surname">
                <summary>Remove professor permanently</summary>
                <p>This deletes @p.DisplayName’s saved profile, track, priority, notes, accommodations, and complaints from this browser. Future uploads will not restore the profile.</p>
                <p>Their classes and discussions will also be excluded from future schedules.</p>
                <p class="hint">The current plan stays visible until you rebuild. Uploaded source files are kept. You can add them back from Removed professors, but deleted profile details will not be recovered.</p>
                <label class="inline"><input type="checkbox" @bind="_confirmRemoval" /> I want to permanently remove @p.DisplayName</label>
                <button class="ghost" @onclick="RemoveProfessor" disabled="@(_busy || !_confirmRemoval)">Permanently remove professor</button>
                @if (_removalError != null) { <p role="alert">@_removalError</p> }
            </details>

            @{
                var sections = Planning.LatestPlan?.Placements.Where(x => x.Section.Surname == p.Surname).ToList();
            }
            @if (sections?.Count > 0)
            {
                <h2>In the current plan</h2>
                <table>
                    <tbody>
                        @foreach (var x in sections)
                        {
                            <tr>
                                <td class="mono">@x.Section.Title</td>
                                <td class="mono">@x.Time</td>
                                <td class="mono">@x.Room?.DisplayName</td>
                                <td>@string.Join("; ", x.Section.Flags.Where(f => f.Level != FlagLevel.Info).Select(f => f.Message))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
</div>

@code {
    private string _search = "";
    private FacultyProfile? _selected;
    private string _newComplaint = "";
    private bool _saved;
    private bool _confirmRemoval;
    private string? _removalMessage, _removalError, _restoreError;

    private void AddProfessorBack(string surname)
    {
        _restoreError = null;
        try
        {
            var profile = Planning.Faculty.AddBack(surname);
            Select(profile);
            _search = "";
            _trackChanged = Planning.RequiresRebuild;
            _removalMessage = $"{profile.DisplayName} was added back. Rebuild the schedule to include their classes and discussions from the current files. Deleted profile details have not been recovered.";
        }
        catch (InvalidOperationException ex) { _restoreError = ex.Message; }
        catch (ArgumentException ex) { _restoreError = ex.Message; }
    }

    private void RemoveProfessor()
    {
        if (_selected == null || !_confirmRemoval) return;
        string name = _selected.DisplayName;
        try
        {
            Planning.Faculty.RemovePermanently(_selected.Surname);
            _selected = null; _saved = false; _confirmRemoval = false; _newComplaint = "";
            _trackChanged = Planning.RequiresRebuild;
            _removalMessage = $"{name} was permanently removed from saved faculty in this browser. Their classes and discussions will be excluded when you rebuild.";
        }
        catch (InvalidOperationException ex) { _removalError = ex.Message; }
        catch (ArgumentException ex) { _removalError = ex.Message; }
    }

    private void Select(FacultyProfile p)
    {
        _selected = p;
        _confirmRemoval = false; _removalError = null;
        _saved = false;
        _newComplaint = "";
    }

    private void AddComplaint()
    {
        _selected!.Complaints.Add(new Complaint { Date = DateTime.Today, Text = _newComplaint.Trim() });
        _newComplaint = "";
        Save();
    }

    private bool _busy;
    private bool _trackListOpen = true;
    private bool _trackChanged;

    private void SetTrack(FacultyProfile f, FacultyTrack track)
    {
        f.SetTrack(track);
        Planning.Faculty.Save();
        _trackChanged = true;
    }

    private void SetDifficult(FacultyProfile f, bool difficult)
    {
        f.SetDifficult(difficult);
        Planning.Faculty.Save();
        _trackChanged = true;
    }

    /// <summary>Reruns the last schedule with the saved profiles, then shows it.</summary>
    private async Task RebuildAndShow()
    {
        _busy = true;
        StateHasChanged();
        await Task.Delay(50);
        Planning.Build(Planning.LatestSource);
        _busy = false;
        Nav.NavigateTo("");
    }

    private void Save()
    {
        Planning.Faculty.Save();
        _saved = true;
    }
}
