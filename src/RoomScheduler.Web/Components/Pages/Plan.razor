@page "/"
@page "/plan"
@inject PlanningService Planning
@inject IJSRuntime JS

<PageTitle>Semester plan</PageTitle>

<h1>Semester plan</h1>
@if (Planning.Rooms.Count == 0)
{
    <div class="problems" role="alert">The room inventory could not be loaded. Reload the app or add a rooms table in step 3 before building.</div>
}
<section class="files" aria-label="Files and scheduling settings">
    <div class="files-heading">
        <button type="button" class="ghost file-setup-toggle" aria-expanded="@(_filesOpen ? "true" : "false")" aria-controls="file-setup"
                @onclick="() => _filesOpen = !_filesOpen">@(_filesOpen ? "Collapse file setup" : "Edit files and settings")</button>
        @if (!_filesOpen)
        {
            <span class="summary">@_chosen · @Planning.Past.Label history · @Planning.Rooms.Count rooms</span>
        }
    </div>
    <div id="file-setup" class="files-content" hidden="@(!_filesOpen)">
    @{
        var requests = Planning.Of(FileKind.Requests);
        var past = Planning.Of(FileKind.PastSchedule);
        var rooms = Planning.Of(FileKind.Rooms);
        var capture = Planning.Of(FileKind.LectureCapture);
        var other = Planning.Of(FileKind.Other);
    }

    <div class="upload-step">
        <h3>1. Classes and preferences <span class="req">(required)</span></h3>
        <p class="hint">
            Add a combined workbook, or separate Classes App and Scheduling Preferences files.
            Select the Classes App workbook and, when separate, select its preference file below.
            A filename already used for a different file type is rejected; rename it to keep both.
        </p>
        <InputFile OnChange="e => Upload(e, FileKind.Requests)" accept=".xlsx" multiple />
        @foreach (var f in requests)
        {
            <div class="filerow @(f.Name == _chosen ? "chosen" : "")">
                <label class="inline"><input type="radio" name="req" checked="@(f.Name == _chosen)" @onchange="() => _chosen = f.Name" /> schedule this</label>
                <span class="mono">@f.Name</span>
                <span class="dim">@f.Detail</span>
                <button class="ghost small" @onclick="() => Remove(f.Name)">remove</button>
            </div>
        }
        <label>Separate preferences
            <select @bind="_preferences">
                <option value="">Use tabs in selected Classes App workbook</option>
                @foreach (var f in Planning.Of(FileKind.Preferences))
                {
                    <option value="@f.Name">@f.Name (@f.Detail)</option>
                }
            </select>
        </label>
        @foreach (var f in Planning.Of(FileKind.Preferences))
        {
            <div class="filerow">@f.Name <button class="ghost small" @onclick="() => Remove(f.Name)">remove</button></div>
        }
        @Messages(FileKind.Requests)
    </div>

    <div class="upload-step">
        <h3>2. Past schedules <span class="rec">(recommended)</span></h3>
        <p class="hint">
            What actually ran in earlier semesters (the registrar export with CNBR, DAYS1, BLDG1 columns). Add one file
            per semester; the newest counts as "last time" for times and rooms. Enrollment sizing uses a median across active semesters.
        </p>
        <InputFile OnChange="e => Upload(e, FileKind.PastSchedule)" accept=".xlsx" multiple />
        @foreach (var f in past)
        {
            <div class="filerow">
                <label class="inline">
                    <input type="checkbox" checked="@Planning.ActiveHistory.Contains(f.Name)"
                           @onchange="e => Planning.SetHistoryActive(f.Name, (bool)e.Value!)" /> use
                </label>
                <span class="mono">@f.Name</span>
                <span class="dim">@f.Detail</span>
                <button class="ghost small" @onclick="() => Remove(f.Name)">remove</button>
            </div>
        }
        @Messages(FileKind.PastSchedule)
    </div>

    <div class="upload-step">
        <h3>3. Rooms table <span class="opt">(optional)</span></h3>
        <p class="hint">
            Only if the registrar sends a new GPC rooms-with-features table (Building, Room, Size, Features columns).
            Otherwise the built-in table is used.
        </p>
        <InputFile OnChange="e => Upload(e, FileKind.Rooms)" accept=".xlsx" />
        @foreach (var f in rooms)
        {
            <div class="filerow">
                <span class="dim">@(f.Name == Planning.RoomsSource ? "in use" : "older")</span>
                <span class="mono">@f.Name</span>
                <span class="dim">@f.Detail</span>
                <button class="ghost small" @onclick="() => Remove(f.Name)">remove</button>
            </div>
        }
        @Messages(FileKind.Rooms)
    </div>

    <div class="upload-step">
        <h3>4. Additional files <span class="opt">(optional)</span></h3>
        <p class="hint">
            Anything else for this semester. A new Lectures Online room list from the registrar is used for
            recording requests (now using @Planning.LectureCaptureSource, @Planning.LectureCaptureRooms rooms).
            Course Reference and Faculty Reference templates are also accepted here (or as tabs in the Classes App workbook).
            Course Reference: Course, Minimum Room Capacity, Preferred Room Capacity, optional Semester (e.g. Fall 2027).
            Faculty Reference: Professor, Tenure or PTF (T/PTF). Saved faculty edits take precedence.
            Other files, such as notes or maps, are kept here for reference.
        </p>
        <InputFile OnChange="e => Upload(e, FileKind.Other)" multiple />
        @foreach (var f in capture)
        {
            <div class="filerow">
                <span class="dim">@(f.Name == Planning.LectureCaptureSource ? "in use" : "older")</span>
                <span class="mono">@f.Name</span>
                <span class="dim">@f.Detail</span>
                <button class="ghost small" @onclick="() => Remove(f.Name)">remove</button>
            </div>
        }
        @foreach (var f in other.Concat(Planning.Of(FileKind.Reference)))
        {
            <div class="filerow">
                <span class="mono">@f.Name</span>
                <span class="dim">@f.Detail</span>
                <button class="ghost small" @onclick="() => DownloadFile(f.Name)">download</button>
                <button class="ghost small" @onclick="() => Remove(f.Name)">remove</button>
            </div>
        }
        @Messages(FileKind.Other)
    </div>

    <p class="hint"><label class="inline"><input type="checkbox" @bind="Planning.Rules.AllowAlternateTimes" />
        Try provisional alternate times when requested/history times cannot be placed</label>
        Room rearrangements keep existing class times; any alternate time is marked for instructor review.</p>
    <div class="controls">
        <button @onclick="BuildChosen" disabled="@(_busy || _chosen.Length == 0 || Planning.Rooms.Count == 0)">@(_busy ? "Working" : "Build schedule")</button>
        <span class="summary">
            @if (_chosen.Length == 0)
            {
                @("Add a preference sheet in step 1 to schedule.")
            }
            else
            {
                <span>Schedules <b>@_chosen</b> using history from <b>@Planning.Past.Label</b>
                (newest semester counts as "last time"), <b>@Planning.Rooms.Count</b> rooms from @Planning.RoomsSource,
                and <b>@Planning.Faculty.All.Count()</b> faculty profiles.</span>
            }
        </span>
    </div>
    </div>
</section>

@if (_error != null)
{
    <div class="problems">@_error</div>
}

@if (_plan != null)
{
    <p class="meta">Showing the schedule built from <b>@Planning.LatestSource</b>.</p>
}

@if (_plan != null)
{
    var counts = _plan.Placements.GroupBy(p => p.Status).ToDictionary(g => g.Key, g => g.Count());
    var flags = _plan.AllFlags.Select(x => x.Flag).Concat(_plan.GeneralFlags).ToList();

    <div class="stats">
        <div><strong>@counts.GetValueOrDefault("Scheduled")</strong> scheduled</div>
        <div><strong>@(counts.GetValueOrDefault("Not scheduled") + counts.GetValueOrDefault("No room"))</strong> need placing</div>
        <div><strong>@counts.GetValueOrDefault("Online")</strong> online</div>
        @if (_plan.Rules.ScheduleDiscussions)
        {
            <div><strong>@_plan.Discussions.Count</strong> discussions</div>
        }
        <div class="bad"><strong>@flags.Count(f => f.Level == FlagLevel.Problem)</strong> problems</div>
        <div class="mid"><strong>@flags.Count(f => f.Level == FlagLevel.Review)</strong> to review</div>
        <div><strong>@_plan.Placements.Count(p => p.Fit == "Max high")</strong> rooms max high</div>
        <div class="right">
            <button class="ghost" @onclick="Rebuild" disabled="@_busy" title="Run the schedule again with the current faculty profiles">Rebuild</button>
            <button @onclick="DownloadAll" disabled="@(_needsRebuild || Planning.RequiresRebuild)">Download workbook</button>
            <button class="ghost" @onclick="DownloadGrids" disabled="@(_needsRebuild || Planning.RequiresRebuild)">Room calendars only</button>
        </div>
    </div>

    @if (_needsRebuild || Planning.RequiresRebuild)
    {
        <div class="problems rebuild">
            Planning inputs or faculty settings changed. This is the previous schedule; rebuild to apply the changes.
            <button @onclick="Rebuild" disabled="@_busy">@(_busy ? "Working" : "Rebuild now")</button>
        </div>
    }

    <details>
        <summary>Course room baseline for @_plan.Semester</summary>
        <p>Minimum is a hard floor in physical seats; preferred steers room choice. Enrollment still controls the required student count.
            The registrar cap remains capacity minus 10%. Values below replace this semester's reference baseline; 0 clears a value.
            Saving rebuilds the plan and replaces manual overrides.</p>
        <select @bind="_baselineCourse">
            @foreach (var course in _plan.Placements.Select(p => p.Section.Course).Distinct())
            { <option value="@course">@course</option> }
        </select>
        <label>Minimum seats <input type="number" min="0" @bind="_minimumCapacity" /></label>
        <label>Preferred seats <input type="number" min="0" @bind="_preferredCapacity" /></label>
        <button @onclick="SaveBaseline">Save for semester and rebuild</button>
    </details>

    <div class="tabs">
        @foreach (var t in new[] { "Schedule", "Review queue", "Room grid" })
        {
            <button class="@(_tab == t ? "tab on" : "tab")" @onclick="() => _tab = t">@t</button>
        }
    </div>

    @if (_tab == "Schedule")
    {
        <div class="controls">
            <label for="f">Filter</label>
            <input id="f" placeholder="course, instructor, room" @bind="_filter" @bind:event="oninput" />
            <label><input type="checkbox" @bind="_onlyFlagged" /> only sections with something to review</label>
        </div>

        <div class="tablewrap">
        <table class="plan-table">
            <thead>
                <tr>
                    <th>Course</th><th>Instructor</th>
                    <th title="Click D to mark difficult faculty (scheduled first). T tenure track, P professional track.">Pri</th>
                    <th>When</th><th>Room</th><th class="num" title="Students expected">Size</th>
                    <th class="num" title="Size reported to the registrar: room capacity minus 10%">Report</th>
                    <th class="num" title="How far the reported size runs over the students expected. 50-75% is allowed.">Over</th>
                    <th>Fit</th>
                    @if (_plan.Rules.ScheduleDiscussions) { <th>Discussion</th> }
                    <th>Why</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Shown())
                {
                    var open = p.Section.Flags.Count(f => f.Level != FlagLevel.Info);
                    <tr class="@RowClass(p)">
                        <td class="mono course">@p.Section.Title</td>
                        <td class="instructor">@(p.Section.InstructorMissing ? "TBD" : p.Section.Instructor)</td>
                        <td class="mono nowrap">
                            @if (p.Section.Profile != null)
                            {
                                <button class="dtoggle @(p.Section.Difficult ? "on" : "")" title="Difficult faculty: click to toggle, then rebuild"
                                        @onclick="() => ToggleDifficult(p.Section)">D</button>
                            }
                            @if (p.Section.Profile != null)
                            {
                                <button class="dtoggle track" title="Tenure track (T) or professional track (P): click to switch, then rebuild"
                                        @onclick="() => ToggleTrack(p.Section)">@TrackLetter(p.Section.Track)</button>
                            }
                            else
                            {
                                @TrackLetter(p.Section.Track)
                            }
                        </td>
                        <td class="mono nowrap">
                            @(p.Time?.Pattern ?? (p.Section.Online ? "WEB" : "-"))
                            <div class="sub">@(p.Time?.Clock ?? "")</div>
                        </td>
                        <td class="mono nowrap">
                            @(p.Room?.DisplayName ?? (p.Section.Online ? "Online — no room needed" : "Unassigned — see review"))
                            @if (p.Room != null) { <div class="sub">@p.Room.Capacity seats</div> }
                        </td>
                        <td class="num" title="Projected @p.Section.ProjectedSize, historical median @p.Section.PastEnrollment, minimum seats @p.Section.MinimumRoomCapacity, preferred seats @p.Section.PreferredRoomCapacity">@p.Section.SizeForRoom</td>
                        <td class="num">@p.RegistrarCap</td>
                        <td class="num">@(p.Room == null ? "" : _plan.Rules.OverReported(p.Room.Capacity, p.Section.SizeForRoom).ToString("+0%;-0%;0%"))</td>
                        <td><span class="fit @FitClass(p.Fit)">@p.Fit</span></td>
                        @if (_plan.Rules.ScheduleDiscussions)
                        {
                            <td class="mono nowrap" title="@(p.Discussion == null ? "" : string.Join("; ", p.Discussion.Why))">
                                @if (p.Discussion != null)
                                {
                                    @p.Discussion.Time
                                    <div class="sub">@p.Discussion.Room?.DisplayName</div>
                                }
                            </td>
                        }
                        <td class="why-cell">
                            @string.Join("; ", p.Why)
                            @if (open > 0)
                            {
                                <span class="flagcount" title="@string.Join("\n", p.Section.Flags.Where(f => f.Level != FlagLevel.Info).Select(f => f.Message))">@open to review</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
    else if (_tab == "Review queue")
    {
        <p class="explain">
            Problems first, then things to review. "Possible inaccuracy" covers requests that contradict
            themselves, the course's credit hours, or the record of past semesters.
        </p>
        @foreach (var level in new[] { FlagLevel.Problem, FlagLevel.Review, FlagLevel.Info })
        {
            var items = _plan.GeneralFlags.Where(f => f.Level == level).Select(f => ((Placement?)null, f))
                .Concat(_plan.AllFlags.Where(x => x.Flag.Level == level).Select(x => ((Placement?)x.Placement, x.Flag)))
                .ToList();
            if (items.Count == 0) continue;

            <details open="@(level != FlagLevel.Info)">
                <summary>@level (@items.Count)</summary>
                @foreach (var group in items.GroupBy(i => i.Item2.Category).OrderBy(g => g.Key))
                {
                    <h2>@group.Key</h2>
                    <table>
                        <tbody>
                            @foreach (var (p, f) in group)
                            {
                                <tr>
                                    <td class="mono">@(p?.Section.Title ?? "")</td>
                                    <td>@(p?.Section.Instructor ?? "")</td>
                                    <td>@f.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </details>
        }
    }
    else if (_tab == "Room grid")
    {
        <div class="controls">
            <label for="room">Room</label>
            <select id="room" @bind="_gridRoom">
                @foreach (var r in GridRooms())
                {
                    var inUse = _plan.InRoom(r).Count > 0;
                    <option value="@r.DisplayName">@(inUse ? PlanExport.UsedMark : "")@r.DisplayName (@r.Capacity)@(inUse ? "" : " - empty")</option>
                }
            </select>
            <span class="summary">● marks rooms with classes this semester. @GridRoom()?.Notes</span>
        </div>

        var room = GridRoom();
        if (room != null)
        {
            var inRoom = _plan.InRoom(room);
            <table class="grid">
                <thead>
                    <tr><th></th>@foreach (var d in Weekdays) { <th>@d</th> }</tr>
                </thead>
                <tbody>
                    @for (var t = new TimeSpan(8, 0, 0); t < new TimeSpan(21, 0, 0); t += TimeSpan.FromMinutes(30))
                    {
                        var slot = t;
                        <tr>
                            <td class="mono dim">@MeetingTime.ClockTime(slot)</td>
                            @foreach (var d in Weekdays)
                            {
                                var here = inRoom.FirstOrDefault(p => p.Time!.Days.Contains(d) && p.Time.Start <= slot && slot < p.Time.End);
                                if (here == null)
                                {
                                    <td></td>
                                }
                                else
                                {
                                    bool first = here.Time!.Start > slot - TimeSpan.FromMinutes(30);
                                    <td class="busy" style="background:@ColorFor(here.Label)">
                                        @if (first)
                                        {
                                            <b>@here.Label</b><br />@(here.IsDiscussion ? "TA" : here.Section.Instructor)
                                        }
                                    </td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
}

@code {
    private static readonly DayOfWeek[] Weekdays =
        { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday };

    private static readonly string[] Palette =
        { "#fce4d6", "#ddebf7", "#e2efda", "#fff2cc", "#ede1f5", "#d9f2f2", "#f8d7da", "#ffe699", "#c6e0b4", "#bdd7ee" };

    private string _chosen = "";
    private string _preferences = "";
    private string _baselineCourseValue = "";
    private string _baselineCourse
    {
        get => _baselineCourseValue;
        set
        {
            _baselineCourseValue = value;
            var section = _plan?.Placements.FirstOrDefault(p => p.Section.Course == value)?.Section;
            _minimumCapacity = section?.MinimumRoomCapacity ?? 0;
            _preferredCapacity = section?.PreferredRoomCapacity ?? 0;
        }
    }
    private int _minimumCapacity;
    private int _preferredCapacity;

    private async Task SaveBaseline()
    {
        try
        {
            Planning.SetSemesterBaseline(_plan!.Semester, _baselineCourse, _minimumCapacity, _preferredCapacity);
            await Rebuild();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private Planner.Plan? _plan;
    private string? _error;
    private bool _busy;
    private bool _filesOpen = true;
    private string _tab = "Schedule";
    private string _filter = "";
    private bool _onlyFlagged;
    private string _gridRoom = "GDC 2.216";
    private List<(string Text, bool Ok)> _messages = new();


    protected override void OnInitialized()
    {
        _plan = Planning.LatestPlan;
        _filesOpen = _plan == null;
        _preferences = Planning.LatestPreferences ?? "";
        _baselineCourse = _plan?.Placements.FirstOrDefault()?.Section.Course ?? "";
        var requests = Planning.Of(FileKind.Requests);
        _chosen = requests.Any(f => f.Name == Planning.LatestSource)
            ? Planning.LatestSource
            : requests.FirstOrDefault()?.Name ?? "";
    }

    private Task BuildChosen() => Run(() => Planning.Build(_chosen, _preferences));

    /// <summary>Runs the same workbook again, picking up profile changes such as difficult faculty.</summary>
    private Task Rebuild() => Run(() => Planning.Build(Planning.LatestSource, Planning.LatestPreferences));

    private static string TrackLetter(FacultyTrack t) =>
        t switch { FacultyTrack.Tenure => "T", FacultyTrack.Professional => "P", _ => "?" };

    /// <summary>Switches a professor between tenure (T) and professional (P) track. Takes effect on the next build.</summary>
    private void ToggleTrack(SectionRequest s)
    {
        s.Profile!.Track = s.Profile.Track == FacultyTrack.Tenure ? FacultyTrack.Professional : FacultyTrack.Tenure;
        foreach (var p in _plan!.Placements.Where(x => x.Section.Profile == s.Profile))
            p.Section.Track = s.Profile.Track;
        Planning.Faculty.Save();
        _needsRebuild = true;
    }

    /// <summary>
    /// Saves each chosen file. The file's columns decide what it is; if it was
    /// added under the wrong step it still goes where it belongs, with a note.
    /// </summary>
    private async Task Upload(InputFileChangeEventArgs e, FileKind expected)
    {
        _messages = new();
        _messageSection = expected;
        _error = null;
        foreach (var file in e.GetMultipleFiles(20))
        {
            try
            {
                using var ms = new MemoryStream();
                if (file.Size > PlanningSession.MaxFileBytes)
                {
                    _messages.Add(($"{file.Name}: too large to keep in the browser (limit {PlanningSession.SizeText(PlanningSession.MaxFileBytes)}). Not saved.", false));
                    continue;
                }
                await file.OpenReadStream(PlanningSession.MaxFileBytes).CopyToAsync(ms);
                var info = Planning.Save(file.Name, ms.ToArray(), expected);

                if (info.Kind == FileKind.Unknown)
                    _messages.Add(($"{file.Name}: {info.Detail}. Not saved." +
                                   (expected == FileKind.Other ? "" : " To keep it anyway, add it under 4. Additional files."), false));
                else
                {
                    _messages.Add(info.Kind == expected || (expected == FileKind.Other && info.Kind == FileKind.LectureCapture)
                        ? ($"Saved {info.Name}. Same-name files of this type replace their previous version.", true)
                        : ($"{info.Name} looks like {KindName(info.Kind)}, so it was added there instead.", true));
                    if (info.Kind == FileKind.Requests) _chosen = info.Name;
                }
            }
            catch (Exception ex)
            {
                _messages.Add(($"{file.Name}: {ex.Message}", false));
            }
        }
    }

    private void Remove(string name)
    {
        Planning.Delete(name);
        if (_preferences == name) _preferences = "";
        if (_chosen == name)
            _chosen = Planning.Of(FileKind.Requests).FirstOrDefault()?.Name ?? "";
        _messages = new();
    }

    private static string KindName(FileKind k) => k switch
    {
        FileKind.Preferences => "separate scheduling preferences (step 1)",
        FileKind.Reference => "a course/faculty reference (step 4)",
        FileKind.Requests => "a preference sheet (step 1)",
        FileKind.PastSchedule => "a past schedule (step 2)",
        FileKind.Rooms => "a rooms table (step 3)",
        FileKind.LectureCapture => "a Lectures Online list (step 4)",
        FileKind.Other => "an additional file (step 4)",
        _ => "unknown"
    };

    private async Task DownloadFile(string name)
    {
        if (Planning.FileBytes(name) is byte[] bytes)
            await JS.InvokeVoidAsync("saveFile", name, Convert.ToBase64String(bytes), "application/octet-stream");
    }

    private FileKind _messageSection;

    /// <summary>Upload results, shown under the step the files were added in.</summary>
    private RenderFragment Messages(FileKind section) => __builder =>
    {
        if (_messageSection != section) return;
        foreach (var m in _messages)
        {
            <div class="@(m.Ok ? "summary" : "warn")">@m.Text</div>
        }
    };

    /// <summary>
    /// Builds in the browser. Shows "Working" first: the build holds the page
    /// until it finishes, so it starts only after that has drawn.
    /// </summary>
    private async Task Run(Func<Planner.Plan> build)
    {
        _busy = true;
        _error = null;
        StateHasChanged();
        await Task.Delay(50);
        try
        {
            _plan = build();
            _filesOpen = false;
            _baselineCourse = _plan.Placements.FirstOrDefault()?.Section.Course ?? "";
            _needsRebuild = false;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _filesOpen = true;
        }
        _busy = false;
    }

    private IEnumerable<Placement> Shown() =>
        _plan!.Placements
            .Where(p => !_onlyFlagged || p.Section.Flags.Any(f => f.Level != FlagLevel.Info))
            .Where(p => _filter.Length == 0 ||
                        $"{p.Section.Title} {p.Section.Instructor} {p.Room?.DisplayName}".Contains(_filter, StringComparison.OrdinalIgnoreCase))
            .OrderBy(p => p.Section.SourceRow);

    private string RowClass(Placement p) =>
        p.Section.Flags.Any(f => f.Level == FlagLevel.Problem) ? "row-bad" :
        p.Status is "Not scheduled" or "No room" ? "row-bad" : "";

    private static string FitClass(string fit) =>
        fit == "Max high" ? "max" : fit == "Min high" ? "min" : "";

    private IEnumerable<Room> GridRooms() =>
        Planning.Rooms.Where(r => _plan!.InRoom(r).Count > 0 || r.Building == "GDC")
            .OrderBy(r => _plan!.InRoom(r).Count == 0).ThenBy(r => r.Building != "GDC").ThenBy(r => r.DisplayName);

    private Room? GridRoom() => Planning.Rooms.FirstOrDefault(r => r.DisplayName == _gridRoom);

    private readonly Dictionary<string, string> _colors = new();
    private string ColorFor(string key)
    {
        if (!_colors.TryGetValue(key, out var c))
            _colors[key] = c = Palette[_colors.Count % Palette.Length];
        return c;
    }

    private bool _needsRebuild;

    /// <summary>Marks or unmarks difficult faculty on their profile. Takes effect on the next build.</summary>
    private void ToggleDifficult(SectionRequest s)
    {
        s.Profile!.Difficult = !s.Profile.Difficult;
        foreach (var p in _plan!.Placements.Where(x => x.Section.Profile == s.Profile))
            p.Section.Difficult = s.Profile.Difficult;
        Planning.Faculty.Save();
        _needsRebuild = true;
    }

    private async Task DownloadAll() =>
        await Save($"{FileStem()} schedule.xlsx", PlanExport.Workbook(_plan!, Planning.Rooms));

    private async Task DownloadGrids() =>
        await Save($"{FileStem()} room calendars.xlsx", PlanExport.GridsOnly(_plan!, Planning.Rooms));

    private string FileStem() => string.IsNullOrWhiteSpace(_plan?.Semester) ? "Semester" : _plan!.Semester;

    private async Task Save(string name, byte[] bytes) =>
        await JS.InvokeVoidAsync("saveFile", name, Convert.ToBase64String(bytes));
}
