@page "/upload"
@rendermode InteractiveServer
@inject SchedulingService Scheduling

<PageTitle>Upload</PageTitle>

<h1>Upload a course list</h1>
<p class="explain">
    Load a CSV of real sections and each is assigned a room without time clashes.
</p>
<p class="meta">CSV, up to 5 MB. Assigned against @Scheduling.RoomCount rooms.</p>

<div class="controls">
    <InputFile OnChange="OnFileChosen" accept=".csv,.txt" />
    <button class="ghost" @onclick="LoadSample">Load sample</button>
    @if (_result is not null)
    {
        <span class="summary">
            <strong>@_loadedCount</strong> read from @_fileName,
            <strong>@_result.Assignments.Count</strong> assigned,
            <strong>@_result.UnresolvedConflicts.Count</strong> unplaced
        </span>
    }
</div>

<details>
    <summary>Accepted columns</summary>
    <div class="body">
        Required: course, enrollment, days, start, and either end or duration.
        Optional: instructor, unique.
        Days may be written <span class="mono">MWF</span> or
        <span class="mono">Mon,Wed,Fri</span>.
        Times may be <span class="mono">930</span>, <span class="mono">130P</span>,
        <span class="mono">9:30 AM</span> or <span class="mono">14:00</span>.
        Header spelling is matched loosely, so most registrar exports work unedited.
    </div>
</details>

@if (_problems.Count > 0)
{
    <div class="problems">
        @_problems.Count row(s) skipped.
        <ul>
            @foreach (var problem in _problems.Take(10))
            {
                <li>@problem</li>
            }
        </ul>
        @if (_problems.Count > 10)
        {
            <p class="dim">and @(_problems.Count - 10) more.</p>
        }
    </div>
}

@if (_result is not null)
{
    <h2>Assigned</h2>
    <table>
        <thead>
            <tr>
                <th>Course</th><th>Day</th><th>Hour</th><th>Room</th>
                <th class="num">Cap</th><th class="num">Enrl</th>
                <th>Instructor</th><th>Room chosen because</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (course, room) in _result.Assignments)
            {
                var why = _result.ExplainChoice(course, room);
                <tr>
                    <td class="mono">@course.CourseName</td>
                    <td class="mono">@course.MeetingPattern</td>
                    <td class="mono">@course.ClockRange</td>
                    <td class="mono">@room.Building @room.RoomNumber</td>
                    <td class="num">@room.Capacity</td>
                    <td class="num">@course.EnrollmentCount</td>
                    <td>@course.ProfessorName</td>
                    <td class="@(why.StartsWith("best") ? "why" : "why-history")">@why</td>
                </tr>
            }
        </tbody>
    </table>

    @if (_result.UnresolvedConflicts.Count > 0)
    {
        <h2>Unplaced</h2>
        <table>
            <thead>
                <tr><th>Course</th><th>Day</th><th>Hour</th><th class="num">Enrl</th><th>Instructor</th></tr>
            </thead>
            <tbody>
                @foreach (var course in _result.UnresolvedConflicts)
                {
                    <tr>
                        <td class="mono">@course.CourseName</td>
                        <td class="mono">@course.MeetingPattern</td>
                        <td class="mono">@course.ClockRange</td>
                        <td class="num">@course.EnrollmentCount</td>
                        <td>@course.ProfessorName</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private Scheduler? _result;
    private List<string> _problems = new();
    private string _fileName = "";
    private int _loadedCount;

    private const long MaxBytes = 5 * 1024 * 1024;

    private async Task OnFileChosen(InputFileChangeEventArgs e)
    {
        _result = null;
        _problems = new List<string>();
        _fileName = e.File.Name;

        if (e.File.Size > MaxBytes)
        {
            _problems.Add($"That file is {e.File.Size / 1024 / 1024} MB. The limit is 5 MB.");
            return;
        }

        using var stream = e.File.OpenReadStream(MaxBytes);
        using var reader = new StreamReader(stream);
        string text = await reader.ReadToEndAsync();

        Schedule(text);
    }

    private void LoadSample()
    {
        _fileName = "sample";
        var courses = Scheduler.GenerateFakeCourses(20);

        var csv = new System.Text.StringBuilder();
        csv.AppendLine("course,instructor,enrollment,days,start,end");
        foreach (var c in courses)
        {
            csv.AppendLine($"{c.CourseName},\"{c.ProfessorName}\",{c.EnrollmentCount}," +
                           $"{c.MeetingPattern},{c.StartTime:hh\\:mm},{c.EndTime:hh\\:mm}");
        }

        _problems = new List<string>();
        Schedule(csv.ToString());
    }

    private void Schedule(string csvText)
    {
        using var reader = new StringReader(csvText);
        var load = CourseCsv.Load(reader);

        _problems.AddRange(load.Problems);
        _loadedCount = load.Courses.Count;

        _result = load.Courses.Count > 0 ? Scheduling.Run(load.Courses) : null;
    }
}
