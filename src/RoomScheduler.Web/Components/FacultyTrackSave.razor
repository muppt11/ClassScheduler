@inject PlanningService Planning

<div class="controls">
    <button type="button" @onclick="Save" disabled="@Disabled">Save faculty tracks</button>
    @if (_saved)
    {
        <span class="summary" role="status">Saved. Tenure, professional track, and difficult selections will stay when you reopen this app in this browser.</span>
    }
</div>
@if (_error != null)
{
    <p class="problems" role="alert">Could not save faculty tracks: @_error Try saving again.</p>
}

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    private bool _saved;
    private string? _error;

    private async Task Save()
    {
        _saved = false;
        _error = null;
        try
        {
            Planning.Faculty.Save();
            await OnSaved.InvokeAsync();
            _saved = true;
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
