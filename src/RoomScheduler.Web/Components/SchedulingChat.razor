@inject PlanningService Planning
@inject IJSRuntime JS

<section class="scheduling-assistant" aria-labelledby="assistant-heading">
    <div class="assistant-heading">
        <h2 id="assistant-heading">Scheduling chatbot</h2>
        <span class="assistant-badge">Preview before applying</span>
    </div>
    <p class="hint">Ask about your schedule, compare rooms and times, or explore swaps. Every proposed change is checked before you review and apply it.</p>
    <div class="chat-history" @ref="_chatLog" role="log" aria-live="polite" aria-label="Scheduling assistant conversation">
        <div class="chat-message assistant-message"><b>Assistant</b><p>Tell me what you want to improve. For example: “Find comp arch a slot in GDC after 2pm, no Fridays”,
            “Find a smaller room but keep the same time”, or “Swap rooms for comp arch with data structures”.
            I can compare up to three checked options, remember your follow-up conditions, and explain who would move. You approve the preview before anything changes.</p></div>
        @foreach (var message in _chatMessages)
        {
            <div class="chat-message @(message.User ? "user-message" : "assistant-message")"><b>@(message.User ? "You" : "Assistant")</b><p>@message.Text</p></div>
        }
    </div>
    @if (_chatMessages.Count == 0)
    {
        <div class="chat-suggestions" aria-label="Example requests">
            @foreach (var example in new[] { "What needs attention?", "Which classes have no room?", "What can you do?" })
            { <button type="button" class="ghost" disabled="@(Blocked || _sending)" @onclick="() => SendMessage(example)">@example</button> }
        </div>
    }
    @if (Conversation.RequestContext is string context)
    {
        <div class="chat-context"><p>@context</p><button type="button" class="ghost small" disabled="@(Blocked || _sending)" @onclick="CancelProposal">Reset request</button></div>
    }
    @if (Conversation.Suggestions.Count > 0)
    {
        <div class="chat-suggestions" aria-label="Suggested replies">
            @foreach (var choice in Conversation.Suggestions)
            {
                <button type="button" class="ghost" disabled="@(Blocked || _sending)" @onclick="() => SendMessage(choice)">@choice</button>
            }
        </div>
    }
    <form class="chat-composer" @onsubmit="SendChat" @onsubmit:preventDefault>
        <label class="chat-input-label" for="assistant-request">Message the scheduling assistant</label>
        <input id="assistant-request" @bind="_overrideText" @bind:event="oninput" placeholder="Ask for help or describe a room/time change…" autocomplete="off" />
        <button type="submit" disabled="@(Blocked || _sending)">@(_sending ? "Checking…" : "Send")</button>
    </form>
    @if (_sending) { <p role="status">Checking rooms, swap partners and scheduling constraints…</p> }
    <label class="inline"><input type="checkbox" @bind="_allowOversized" /> Allow an intentional oversized-room exception for the next request</label>
    <p class="hint">Uses the current schedule in this browser. Room-only swaps keep times; room-and-time swaps are labeled in the preview. Rebuild or reload resets manual moves.</p>
    @if (Blocked) { <p class="warn">Planning inputs changed. Rebuild on Semester plan before requesting or applying changes.</p> }
    @if (_proposal != null)
    {
        <div class="assistant-proposal">
            <h3>Proposed changes — not yet applied</h3>
            <p>@_proposal.Explanation</p>
            <div class="tablewrap"><table>
                <thead><tr><th>Section</th><th>Before</th><th>Proposed</th></tr></thead>
                <tbody>
                    @foreach (var change in _proposal.ProposedChanges)
                    { <tr><td>@change.Placement.Section.Title — @change.Placement.Section.Instructor<div class="sub">Source row @(change.Placement.Section.SourceRow + 1)</div></td><td>@change.BeforeRoom?.DisplayName @change.BeforeTime</td><td>@change.Room.DisplayName @change.Time</td></tr> }
                </tbody>
            </table></div>
            <button @onclick="ApplyOverride" disabled="@(Blocked || _sending)">Apply reviewed changes</button>
            <button class="ghost" @onclick="CancelProposal">Cancel</button>
        </div>
    }
</section>
@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnApplied { get; set; }
    private string _overrideText = "";
    private bool _allowOversized;
    private bool _sending;
    private ElementReference _chatLog;
    private int _shownMessages = -1;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shownMessages == Conversation.Messages.Count) return;
        _shownMessages = Conversation.Messages.Count;
        await JS.InvokeVoidAsync("scrollChatToBottom", _chatLog);
    }
    private bool Blocked => Disabled || Planning.RequiresRebuild;
    private SchedulingConversation Conversation => Planning.Conversation;
    private Planner.OverrideProposal? _proposal => Conversation.Proposal;
    private List<ChatMessage> _chatMessages => Conversation.Messages;

    protected override void OnParametersSet() => Conversation.Sync(Planning.RequiresRebuild ? null : Planning.LatestPlan);

    private Task SendChat() => SendMessage(_overrideText);
    private async Task SendMessage(string request)
    {
        if (Blocked || _sending || string.IsNullOrWhiteSpace(request)) return;
        _overrideText = ""; _sending = true;
        StateHasChanged();
        await Task.Delay(40);
        try
        {
            Conversation.Send(Planning.LatestPlan, Planning.Rooms, Planning.ProposeOverride, request, _allowOversized,
                Planning.ProposeMove, Planning.ProposeSwap);
            _allowOversized = false;
        }
        catch (Exception ex) { Conversation.Messages.Add(new(false, "I couldn't complete that request. " + ex.Message + " Your schedule is unchanged.")); }
        finally { _sending = false; }
    }
    private async Task ApplyOverride()
    {
        if (Blocked || _sending || _proposal == null) return;
        try
        {
            Planning.ApplyOverride(_proposal!);
            Conversation.Applied();
            await OnApplied.InvokeAsync();
        }
        catch (Exception ex) { Conversation.Messages.Add(new(false, ex.Message)); }
    }
    private void CancelProposal() => Conversation.Cancel();
}
