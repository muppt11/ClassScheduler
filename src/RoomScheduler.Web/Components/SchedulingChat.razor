@inject PlanningService Planning

<section class="scheduling-assistant" aria-labelledby="assistant-heading">
    <div class="assistant-heading">
        <h2 id="assistant-heading">Scheduling chatbot</h2>
        <span class="assistant-badge">Preview before applying</span>
    </div>
    <p class="hint">Ask about this schedule or request a room change. Changes are checked for conflicts and shown for your review.</p>
    <div class="chat-history" role="log" aria-live="polite" aria-label="Scheduling assistant conversation">
        <div class="chat-message assistant-message"><b>Assistant</b><p>Upload your Classes App and preferences below, then build a schedule.
            I can show what needs review, explain unassigned classes, or help move a class. Try “Show review summary” or
            “Put 398T in GDC 2.216 Monday through Thursday at 10:00am-11:00am”.</p></div>
        @foreach (var message in _chatMessages)
        {
            <div class="chat-message @(message.User ? "user-message" : "assistant-message")"><b>@(message.User ? "You" : "Assistant")</b><p>@message.Text</p></div>
        }
    </div>
    <form class="chat-composer" @onsubmit="SendChat" @onsubmit:preventDefault>
        <label class="chat-input-label" for="assistant-request">Message the scheduling assistant</label>
        <input id="assistant-request" @bind="_overrideText" placeholder="Ask for help or describe a room/time change…" autocomplete="off" />
        <button type="submit" disabled="@Disabled">Send</button>
    </form>
    <label class="inline"><input type="checkbox" @bind="_allowOversized" /> Allow an intentional oversized-room exception for the next request</label>
    <p class="hint">Supported commands run in this browser. Room moves keep displaced classes at their existing times. Rebuild or reload resets manual moves.</p>
    @if (Disabled) { <p class="warn">Rebuild the schedule to use your faculty changes before requesting a move.</p> }
    @if (_proposal != null)
    {
        <div class="assistant-proposal">
            <h3>Proposed changes — not yet applied</h3>
            <p>@_proposal.Explanation</p>
            <div class="tablewrap"><table>
                <thead><tr><th>Section</th><th>Before</th><th>Proposed</th></tr></thead>
                <tbody>
                    @foreach (var change in _proposal.ProposedChanges)
                    { <tr><td>@change.Placement.Section.Title — @change.Placement.Section.Instructor</td><td>@change.BeforeRoom?.DisplayName @change.BeforeTime</td><td>@change.Room.DisplayName @change.Time</td></tr> }
                </tbody>
            </table></div>
            <button @onclick="ApplyOverride" disabled="@Disabled">Apply reviewed changes</button>
            <button class="ghost" @onclick="CancelProposal">Cancel</button>
        </div>
    }
</section>
@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnApplied { get; set; }
    private Planner.Plan? _plan => Planning.LatestPlan;
    private Planner.Plan? _lastPlan;
    private string _overrideText = "";
    private bool _allowOversized;
    private Planner.OverrideProposal? _proposal;
    protected override void OnParametersSet()
    {
        if (_lastPlan != _plan || Disabled) _proposal = null;
        _lastPlan = _plan;
    }
    private List<(bool User, string Text)> _chatMessages = new();
    private void SendChat()
    {
        string request = _overrideText.Trim();
        if (request.Length == 0) return;
        _chatMessages.Add((true, request));
        _overrideText = "";
        _proposal = null;
        if (!request.StartsWith("Put ", StringComparison.OrdinalIgnoreCase) &&
            (request.Equals("help", StringComparison.OrdinalIgnoreCase) || request.StartsWith("how ", StringComparison.OrdinalIgnoreCase)))
        {
            _chatMessages.Add((false, "Upload combined or separate Classes App and preference files, select them, then Build schedule. " +
                "I understand: Show review summary; Show schedule summary; or Put [course number or exact title] in [room] [days] at [start-end]. " +
                "Use am/pm, for example 10:00am-11:00am. For duplicate sections use title / instructor / row N from the source spreadsheet. " +
                "For a large room such as GDC 2.216, select the oversized-room exception if needed."));
            return;
        }
        if (_plan == null)
        {
            _chatMessages.Add((false, "Add your Classes App and preferences below, then click Build schedule. I need a built schedule to check availability and propose changes. You can also type Help."));
            return;
        }
        if (!request.StartsWith("Put ", StringComparison.OrdinalIgnoreCase) &&
            new[] { "unassigned", "unscheduled", "no room", "not scheduled", "missing room" }.Any(word => request.Contains(word, StringComparison.OrdinalIgnoreCase)))
        {
            var unplaced = _plan.Placements.Where(p => !p.Section.Online && p.Room == null).ToList();
            _chatMessages.Add((false, unplaced.Count == 0 ? "Every in-person section has a room. Online sections intentionally have no classroom." :
                string.Join("\n", unplaced.Select(p => $"{p.Section.Title} ({p.Section.Instructor}): " +
                    string.Join("; ", p.Section.Flags.Where(f => f.Level == FlagLevel.Problem).Select(f => f.Message))))));
            return;
        }
        if (!request.StartsWith("Put ", StringComparison.OrdinalIgnoreCase) &&
            (request.Contains("summary", StringComparison.OrdinalIgnoreCase) || request.Contains("review", StringComparison.OrdinalIgnoreCase)))
        {
            var flags = _plan.AllFlags.Select(x => x.Flag).Concat(_plan.GeneralFlags).ToList();
            _chatMessages.Add((false, $"{_plan.Placements.Count(p => p.Status == "Scheduled")} sections scheduled; " +
                $"{_plan.Placements.Count(p => p.Status is "No room" or "Not scheduled")} need placing. " +
                $"{flags.Count(f => f.Level == FlagLevel.Problem)} problems and {flags.Count(f => f.Level == FlagLevel.Review)} items to review. " +
                "Open the Review queue below for explanations, or send a room/time change."));
            return;
        }
        try
        {
            _proposal = Planning.ProposeOverride(request, _allowOversized);
            _chatMessages.Add((false, _proposal.ProposedChanges.Count == 0 ? "That section is already assigned to this room and time." :
                $"I found a proposal affecting {_proposal.ProposedChanges.Count} section(s). Review the changes below, then Apply or Cancel. Nothing has changed yet."));
            if (_proposal.ProposedChanges.Count == 0) _proposal = null;
        }
        catch (Exception ex) { _chatMessages.Add((false, ex.Message)); }
    }
    private async Task ApplyOverride()
    {
        try
        {
            Planning.ApplyOverride(_proposal!);
            _proposal = null;
            await OnApplied.InvokeAsync();
            _chatMessages.Add((false, "Applied the reviewed changes. Room and instructor conflicts were checked. The schedule and workbook download now include these assignments."));
        }
        catch (Exception ex) { _chatMessages.Add((false, ex.Message)); _proposal = null; }
    }
    private void CancelProposal()
    {
        _proposal = null;
        _chatMessages.Add((false, "Proposal canceled. Your schedule has not changed."));
    }
}
