@inherits LayoutComponentBase

<div class="utbar">
    <div class="utbar-inner">
        <span class="wordmark">RoomScheduler</span>
        <span class="unit">Classroom Assignment</span>
    </div>
</div>

<nav class="utnav">
    <div class="utnav-inner">
        <NavLink href="" Match="NavLinkMatch.All">Semester plan</NavLink>
        <NavLink href="faculty">Faculty</NavLink>
        <NavLink href="rooms">Rooms</NavLink>
    </div>
</nav>

<div class="page">
    <main>
        @Body
    </main>

    <footer>
        Room data from the registrar's GPC rooms-with-features table and Lectures Online list.
        Past usage extracted from printed course schedules, 2022 to 2026.
        Building positions estimated from the registrar's GPC map.
        A student project, not an official university system.
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">Close</span>
</div>
